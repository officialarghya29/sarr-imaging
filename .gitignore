# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Generated data configs record absolute, machine-specific paths. The committed
# configs/datasets/*.yaml use relative paths and stay portable -- keep it that way.
configs/datasets/generated/

# ---- Datasets (never commit raw SAR data) ----
datasets/raw/**
datasets/processed/**
datasets/splits/**
!datasets/**/.gitkeep
!datasets/**/README.md

# ---- Results / artifacts ----
results/**
!results/.gitkeep
runs/
wandb/
mlruns/
dataset_statistics/
validation_reports/
*.csv
# Generated paper tables ARE committed (they show the honest TBD state).
!paper/tables/*.csv

# ---- Model weights ----
*.pt
*.pth
*.onnx
*.engine
*.torchscript
*.tflite
*.mlpackage
*.coreml
*.h5
*.pb
# One exception, deliberately narrow: the pilot checkpoint the demo serves is committed so a
# hosted instance has weights with no configuration, because `results/**` is excluded and a
# training artefact therefore never reaches a deploy. Everything else stays out. Provenance and
# checksum in weights/README.md; resolution order in docs/DEPLOYMENT.md.
!weights/sarvo_ssac001.pt

# ---- Secrets (NEVER commit tokens) ----
.env
.env.*
*.key
*.pem
secrets.json
kaggle.json

# ---- OS / editors ----
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~
